rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for strict per-user isolation and financial integrity
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasValidOwnerTag(uid) {
      return !('ownerUid' in request.resource.data) || request.resource.data.ownerUid == uid;
    }

    function isValidTimestampString(field) {
      return !(field in request.resource.data) || request.resource.data[field] is string;
    }

    // Deny all root-level access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile root document (metadata only)
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasValidOwnerTag(uid);
      allow delete: if false;

      // 1. Accounts (balances derived strictly from transactions)
      match /accounts/{accountId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && !('balance' in request.resource.data);
        allow delete: if isOwner(uid);
      }

      // 2. Transactions (immutable IDs, non-negative amounts, auditable corrections)
      match /transactions/{transactionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.id == transactionId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.idempotencyKey is string;
        allow update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        // Auditable ledger: void/correct instead of hard-deleting transactions
        allow delete: if false;
      }

      // 3. Income Sources
      match /income_sources/{sourceId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        allow delete: if isOwner(uid);
      }

      // 4. Categories
      match /categories/{categoryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.name is string;
        allow delete: if isOwner(uid);
      }

      // 5. Giving Allocations (linked to source income transaction, protected against double payment)
      match /allocations/{allocationId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.id == allocationId
          && request.resource.data.sourceTransactionId is string
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.allocationType in ['tithe', 'thanksgiving', 'seed'];
        allow update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.sourceTransactionId == resource.data.sourceTransactionId
          && request.resource.data.allocationType == resource.data.allocationType
          && !(resource.data.status == 'paid' && request.resource.data.status == 'paid' && request.resource.data.paymentTransactionId != resource.data.paymentTransactionId);
        allow delete: if false;
      }

      // 6. Budgets
      match /budgets/{budgetId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.limitAmount is number
          && request.resource.data.limitAmount >= 0;
        allow delete: if isOwner(uid);
      }

      // 7. Entrusted Funds (segregated custodial funds)
      match /entrusted_funds/{fundId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.name is string
          && !('balance' in request.resource.data);
        allow delete: if isOwner(uid);
      }

      // 8. Savings Goals
      match /savings_goals/{goalId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.targetAmount is number
          && request.resource.data.targetAmount >= 0;
        allow delete: if isOwner(uid);
      }

      // 9. Recurring Expenses
      match /recurring_expenses/{recurringId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow delete: if isOwner(uid);
      }

      // 10. Tasks
      match /tasks/{taskId} {
        allow read, write: if isOwner(uid) && hasValidOwnerTag(uid);
      }

      // 11. Projects
      match /projects/{projectId} {
        allow read, write: if isOwner(uid) && hasValidOwnerTag(uid);
      }

      // 12. Calendar Events
      match /calendar_events/{eventId} {
        allow read, write: if isOwner(uid) && hasValidOwnerTag(uid);
      }

      // 13. Financial Reports (generated monthly reconciliation snapshots)
      match /financial_reports/{reportId} {
        allow read, create, update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && isValidTimestampString('generatedAt');
        allow delete: if isOwner(uid);
      }

      // 14. Settings (giving percentages, workspace preferences)
      match /settings/{settingId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasValidOwnerTag(uid)
          && (!('tithePercent' in request.resource.data) || (request.resource.data.tithePercent >= 0 && request.resource.data.tithePercent <= 100))
          && (!('thanksgivingPercent' in request.resource.data) || (request.resource.data.thanksgivingPercent >= 0 && request.resource.data.thanksgivingPercent <= 100))
          && (!('seedPercent' in request.resource.data) || (request.resource.data.seedPercent >= 0 && request.resource.data.seedPercent <= 100));
        allow delete: if false;
      }
    }
  }
}
